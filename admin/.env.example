# Copy to admin/.env and fill in. Master copies live in ~/.env on the home
# server. Never commit the filled-in file — .gitignore already covers .env.

# Postgres password for the `even` role. SAME value backend/.env uses:
# the console reads evend's database directly.
# Source: THISISEVEN_DB_PASSWORD in ~/.env (same as EVEN_DB_PASSWORD).
EVEN_DB_PASSWORD=

# Host port to publish on 127.0.0.1. The container always listens on 3025.
# Default 3026 because `glance` currently owns host 3025 on this machine.
ADMIN_HOST_PORT=3026

# How long a signed-in admin stays signed in, in hours (1–720).
ADMIN_SESSION_HOURS=12

# Secure flag on the session cookie. Keep "true" behind Caddy/Cloudflare.
# Set "false" ONLY for a plain-http http://even-admin.home smoke test.
ADMIN_COOKIE_SECURE=true

# Label shown in the authenticator app next to the code.
ADMIN_TOTP_ISSUER=Even Admin

# --- first boot only ----------------------------------------------------------
# These seed the very first admin account, and ONLY when admin.admin_users is
# empty. TOTP is enrolled on that account's first sign-in (a QR is shown once).
# Delete both lines from .env after you have signed in.
# Password must be at least 12 characters and mix letters with a digit/symbol.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- tests --------------------------------------------------------------------
# The Go handler suite refuses any DSN whose database is not named even_test.
# ADMIN_TESTDB=postgres://even:PW@127.0.0.1:5433/even_test?sslmode=disable
